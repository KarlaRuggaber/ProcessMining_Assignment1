<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:celonis="http://www.celonis.com/schema/bpmn/celonis" id="discovered-model" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:process id="Process_1" name="Fine object" isExecutable="false">
    <bpmn2:startEvent id="StartEvent_-1" name="Offence detected">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="EndEvent_-2" name="Fine closed">
      <bpmn2:incoming>Flow_10</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:task id="Task_1" name="Create Fine">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="Task_16" name="Send Fine">
      <bpmn2:incoming>Flow_Spot_No</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="Task_28" name="Insert Fine Notification">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="Task_25" name="Add penalty">
      <bpmn2:incoming>Flow_InTime_No</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="Task_18" name="Payment">
      <bpmn2:incoming>Flow_7</bpmn2:incoming>
      <bpmn2:outgoing>Flow_8</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:task id="Task_9" name="Send for Credit Collection">
      <bpmn2:incoming>Flow_Penalty_No</bpmn2:incoming>
      <bpmn2:outgoing>Flow_CC_End</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:exclusiveGateway id="Gateway_PaidOnSpot" name="Paid on the spot?">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Spot_No</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Spot_Yes</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_PaidInTime" name="Paid within deadline?">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_InTime_No</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_InTime_Yes</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_PaidAfterPenalty" name="Paid after penalty?">
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Penalty_No</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Penalty_Yes</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_PayJoin">
      <bpmn2:incoming>Flow_Spot_Yes</bpmn2:incoming>
      <bpmn2:incoming>Flow_InTime_Yes</bpmn2:incoming>
      <bpmn2:incoming>Flow_Penalty_Yes</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_InstallmentJoin">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:incoming>Flow_Installment</bpmn2:incoming>
      <bpmn2:outgoing>Flow_7</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_FullyPaid" name="Fully paid?">
      <bpmn2:incoming>Flow_8</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Paid_Yes</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Installment</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="Gateway_EndJoin">
      <bpmn2:incoming>Flow_CC_End</bpmn2:incoming>
      <bpmn2:incoming>Flow_Paid_Yes</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_-1" targetRef="Task_1" />
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Gateway_PaidOnSpot" />
    <bpmn2:sequenceFlow id="Flow_Spot_No" name="no" sourceRef="Gateway_PaidOnSpot" targetRef="Task_16" />
    <bpmn2:sequenceFlow id="Flow_Spot_Yes" name="yes" sourceRef="Gateway_PaidOnSpot" targetRef="Gateway_PayJoin" />
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_16" targetRef="Task_28" />
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_28" targetRef="Gateway_PaidInTime" />
