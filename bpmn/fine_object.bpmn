    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Task_25" targetRef="Gateway_PaidAfterPenalty" />
    <bpmn2:sequenceFlow id="Flow_Penalty_No" name="no" sourceRef="Gateway_PaidAfterPenalty" targetRef="Task_9" />
    <bpmn2:sequenceFlow id="Flow_Penalty_Yes" name="yes" sourceRef="Gateway_PaidAfterPenalty" targetRef="Gateway_PayJoin" />
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Gateway_PayJoin" targetRef="Gateway_InstallmentJoin" />
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="Gateway_InstallmentJoin" targetRef="Task_18" />
    <bpmn2:sequenceFlow id="Flow_8" sourceRef="Task_18" targetRef="Gateway_FullyPaid" />
    <bpmn2:sequenceFlow id="Flow_Paid_Yes" name="yes" sourceRef="Gateway_FullyPaid" targetRef="Gateway_EndJoin" />
    <bpmn2:sequenceFlow id="Flow_Installment" name="no (further installment)" sourceRef="Gateway_FullyPaid" targetRef="Gateway_InstallmentJoin" />
    <bpmn2:sequenceFlow id="Flow_CC_End" sourceRef="Task_9" targetRef="Gateway_EndJoin" />
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Gateway_EndJoin" targetRef="EndEvent_-2" />
  </bpmn2:process>
